     return branch.removeprefix("refs/heads/")
 
 
+_PUSH_BRANCH_PREFIX = "farm/"
+
+
+def _require_push_branch(value: Any) -> str:
+    """Only robomp's own `farm/<hex>/<slug>` workspace branches may be pushed.
+
+    The orchestrator (and any agent that reaches its HMAC key) names the branch;
+    refusing everything else keeps the proxy's write credential off `main`,
+    release branches, and other people's branches regardless of GitHub rulesets.
+    """
+    branch = _require_branch(value)
+    if not branch.startswith(_PUSH_BRANCH_PREFIX):
+        raise HTTPException(403, f"push refused: branch must start with {_PUSH_BRANCH_PREFIX}")
+    return branch
+
+
 _RELEASE_TAG_RE = re.compile(r"v[0-9][A-Za-z0-9._-]*")
 
 

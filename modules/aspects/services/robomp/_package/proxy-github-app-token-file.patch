index 41fd8e4..046f11d 100644
--- a/tests/test_proxy_server.py
+++ b/tests/test_proxy_server.py
@@ -12,6 +12,7 @@ from pathlib import Path
 
 import httpx
 import pytest
+import respx
 from pydantic import SecretStr
 
 from robomp.config import Settings
@@ -297,6 +298,40 @@ async def test_get_repo(proxy_settings: Settings) -> None:
     }
 
 
+async def test_token_file_is_reread_per_request(tmp_path: Path) -> None:
+    token_file = tmp_path / "github-token"
+    cfg = _build_settings(tmp_path).model_copy(update={"github_token": None, "github_token_file": token_file})
+    app = create_proxy_app(cfg)
+    seen: list[str] = []
+
+    def gh(req: httpx.Request) -> httpx.Response:
+        seen.append(req.headers["Authorization"])
+        return httpx.Response(
+            200,
+            json={
+                "full_name": "octo/widget",
+                "default_branch": "main",
+                "clone_url": "https://github.com/octo/widget.git",
+                "private": True,
+            },
+        )
+
+    params = {"repo": "octo/widget"}
+    with respx.mock(assert_all_called=False) as mock:
+        mock.get("https://api.github.com/repos/octo/widget").mock(side_effect=gh)
+        async with app.router.lifespan_context(app), await _async_client(app) as client:
+            for token in ("ghs_first", "ghs_second"):
+                token_file.write_text(f"{token}\n")
+                resp = await client.get(
+                    "/gh/v1/repo", params=params, headers=_signed("GET", "/gh/v1/repo", params=params)
+                )
+                assert resp.status_code == 200
+            token_file.unlink()
+            resp = await client.get("/gh/v1/repo", params=params, headers=_signed("GET", "/gh/v1/repo", params=params))
+    assert resp.status_code == 503
+    assert seen == ["Bearer ghs_first", "Bearer ghs_second"]
+
+
 async def test_get_issue(proxy_settings: Settings) -> None:
     def gh(req: httpx.Request) -> httpx.Response:
         assert req.url.path == "/repos/octo/widget/issues/1"

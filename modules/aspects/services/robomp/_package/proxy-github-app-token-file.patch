 def _resolve_token(cfg: Settings) -> str:
+    if cfg.github_token_file is not None:
+        # Re-read per call: an external minter rotates GitHub App installation tokens in place.
+        try:
+            token = cfg.github_token_file.read_text(encoding="utf-8").strip()
+        except OSError as exc:
+            raise HTTPException(503, f"gh-proxy: cannot read token file: {exc.strerror}") from exc
+        if not token:
+            raise HTTPException(503, "gh-proxy: token file is empty")
+        return token
     if cfg.github_token is None:
         # Will already have been caught at startup, but stay defensive.
         raise HTTPException(500, "gh-proxy: GITHUB_TOKEN not configured")

diff --git a/internal/ui/revset/generate.go b/internal/ui/revset/generate.go
new file mode 100644
index 0000000..1ba9eb0
--- /dev/null
+++ b/internal/ui/revset/generate.go
@@ -0,0 +1,223 @@
+package revset
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"time"
+
+	tea "charm.land/bubbletea/v2"
+	"github.com/idursun/jjui/internal/config"
+	"github.com/idursun/jjui/internal/ui/input"
+	"github.com/idursun/jjui/internal/ui/intents"
+)
+
+const aiOutputLimit = 64 * 1024
+
+type generateResultMsg struct {
+	id       int
+	value    string
+	err      error
+	canceled bool
+}
+
+func (m *Model) startGeneratePrompt() tea.Cmd {
+	if !m.editing {
+		return nil
+	}
+	if m.generating {
+		return intents.Invoke(intents.AddMessage{Text: "revset generation already running"})
+	}
+	if strings.TrimSpace(config.Current.Revset.AICommand) == "" {
+		return intents.Invoke(intents.AddMessage{Text: "revset.ai_command is not configured"})
+	}
+	m.awaitingPrompt = true
+	return input.ShowWithTitle("Generate revset", "intent: ", "")
+}
+
+func (m *Model) startGenerateCommand(request string) tea.Cmd {
+	if !m.editing {
+		return nil
+	}
+	command, err := resolveAICommand(config.Current.Revset.AICommand)
+	if err != nil {
+		return intents.Invoke(intents.AddMessage{Text: err.Error(), Err: err})
+	}
+	if strings.TrimSpace(request) == "" {
+		return intents.Invoke(intents.AddMessage{Text: "generation request is empty"})
+	}
+	m.generateID++
+	id := m.generateID
+	if m.generateCancel != nil {
+		m.generateCancel()
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	m.generateCancel = cancel
+	m.generating = true
+	buffer := m.autoComplete.Value()
+	dir := m.context.Location
+	return func() tea.Msg {
+		stdout, stderr, err := runAICommand(ctx, command, request, buffer, dir)
+		if ctx.Err() != nil {
+			return generateResultMsg{id: id, canceled: true}
+		}
+		if err != nil {
+			msg := strings.TrimSpace(stderr)
+			if msg == "" {
+				msg = err.Error()
+			}
+			return generateResultMsg{id: id, err: errors.New(msg)}
+		}
+		line, parseErr := parseGeneratedRevset(stdout)
+		if parseErr != nil {
+			return generateResultMsg{id: id, err: parseErr}
+		}
+		if err := validateGeneratedRevset(ctx, dir, line); err != nil {
+			if ctx.Err() != nil {
+				return generateResultMsg{id: id, canceled: true}
+			}
+			return generateResultMsg{id: id, err: err}
+		}
+		return generateResultMsg{id: id, value: line}
+	}
+}
+
+func (m *Model) handleGenerateResult(msg generateResultMsg) tea.Cmd {
+	if msg.id != m.generateID {
+		return nil
+	}
+	m.generating = false
+	if m.generateCancel != nil {
+		m.generateCancel()
+		m.generateCancel = nil
+	}
+	if msg.canceled || !m.editing {
+		return nil
+	}
+	if msg.err != nil {
+		return intents.Invoke(intents.AddMessage{Text: msg.err.Error(), Err: msg.err})
+	}
+	m.autoComplete.SetValue(msg.value)
+	m.autoComplete.CursorEnd()
+	m.userInput = msg.value
+	m.selectedIndex = -1
+	m.updateCompletionItems()
+	return nil
+}
+
+func (m *Model) cancelGeneration() bool {
+	if !m.generating && m.generateCancel == nil {
+		return false
+	}
+	m.generateID++
+	if m.generateCancel != nil {
+		m.generateCancel()
+		m.generateCancel = nil
+	}
+	m.generating = false
+	return true
+}
+
+func parseGeneratedRevset(output string) (string, error) {
+	if output == "" {
+		return "", errors.New("generated revset was empty")
+	}
+	if strings.HasSuffix(output, "\r\n") {
+		output = strings.TrimSuffix(output, "\r\n")
+	} else {
+		output = strings.TrimSuffix(output, "\n")
+	}
+	if strings.ContainsAny(output, "\r\n") {
+		return "", fmt.Errorf("generated revset must be a single line")
+	}
+	line := strings.TrimSpace(output)
+	if line == "" {
+		return "", errors.New("generated revset was empty")
+	}
+	return line, nil
+}
+
+var validateGeneratedRevset = defaultValidateGeneratedRevset
+
+func defaultValidateGeneratedRevset(ctx context.Context, dir, revset string) error {
+	cmd := exec.CommandContext(ctx, "jj", "log", "-r", revset, "-n", "1", "--ignore-working-copy", "--no-graph", "--color", "never", "--template", `""`)
+	cmd.Dir = dir
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+	cmd.Cancel = func() error {
+		if cmd.Process == nil {
+			return nil
+		}
+		return syscall.Kill(-cmd.Process.Pid, syscall.SIGTERM)
+	}
+	cmd.WaitDelay = 200 * time.Millisecond
+	cmd.Stdout = io.Discard
+	var stderr bytes.Buffer
+	cmd.Stderr = &limitedWriter{buf: &stderr, n: aiOutputLimit}
+	if err := cmd.Run(); err != nil {
+		msg := strings.TrimSpace(stderr.String())
+		if msg == "" {
+			return err
+		}
+		return errors.New(msg)
+	}
+	return nil
+}
+
+func resolveAICommand(command string) (string, error) {
+	command = strings.TrimSpace(command)
+	if command == "" {
+		return "", errors.New("revset.ai_command is not configured")
+	}
+	if !filepath.IsAbs(command) {
+		return "", errors.New("revset.ai_command must be an absolute path")
+	}
+	return command, nil
+}
+
+func runAICommand(ctx context.Context, command, request, stdin, dir string) (string, string, error) {
+	cmd := exec.CommandContext(ctx, command, request)
+	cmd.Dir = dir
+	cmd.Stdin = strings.NewReader(stdin)
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+	cmd.Cancel = func() error {
+		if cmd.Process == nil {
+			return nil
+		}
+		return syscall.Kill(-cmd.Process.Pid, syscall.SIGTERM)
+	}
+	cmd.WaitDelay = 200 * time.Millisecond
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout = &limitedWriter{buf: &stdout, n: aiOutputLimit}
+	cmd.Stderr = &limitedWriter{buf: &stderr, n: aiOutputLimit}
+	err := cmd.Run()
+	return stdout.String(), stderr.String(), err
+}
+
+type limitedWriter struct {
+	buf *bytes.Buffer
+	n   int
+}
+
+func (w *limitedWriter) Write(p []byte) (int, error) {
+	if w.n <= 0 {
+		return len(p), nil
+	}
+	if len(p) > w.n {
+		if _, err := w.buf.Write(p[:w.n]); err != nil {
+			return 0, err
+		}
+		w.n = 0
+		return len(p), nil
+	}
+	n, err := w.buf.Write(p)
+	w.n -= n
+	return n, err
+}
+
+var _ io.Writer = (*limitedWriter)(nil)

+
+func TestGenerate_CancelLeavesBufferAndRevsetUnchanged(t *testing.T) {
+	commandRunner := test.NewTestCommandRunner(t)
+	defer commandRunner.Verify()
+
+	ready := filepath.Join(t.TempDir(), "ready")
+	withAICommand(t, writeHelper(t, "touch "+ready+"\ncat >/dev/null\nsleep 30\n"))
+	model := editingModel(t, commandRunner, "trunk()")
+	originalRevset := model.context.CurrentRevset
+
+	cmd, _ := model.HandleIntent(intents.Generate{})
+	_ = cmd()
+	runCmd := model.Update(input.SelectedMsg{Value: "request"})
+	require.NotNil(t, runCmd)
+
+	done := make(chan tea.Msg, 1)
+	go func() {
+		done <- runCmd()
+	}()
+
+	require.Eventually(t, func() bool {
+		_, err := os.Stat(ready)
+		return err == nil
+	}, 2*time.Second, 10*time.Millisecond)
+	cancelCmd, handled := model.HandleIntent(intents.Cancel{})
+	assert.True(t, handled)
+	assert.Nil(t, cancelCmd)
+	assert.True(t, model.editing, "cancel during generation should keep the editor open")
+	assert.Equal(t, "trunk()", model.GetValue())
+	assert.Equal(t, originalRevset, model.context.CurrentRevset)
+
+	select {
+	case result := <-done:
+		follow := model.Update(result)
+		assert.Nil(t, follow)
+	case <-time.After(5 * time.Second):
+		t.Fatal("generation command did not return after cancel")
+	}
+
+	assert.True(t, model.editing)
+	assert.Equal(t, "trunk()", model.GetValue())
+	assert.Equal(t, originalRevset, model.context.CurrentRevset)
+}
+
+func TestGenerate_ApplyDuringGenerationPreservesState(t *testing.T) {
+	commandRunner := test.NewTestCommandRunner(t)
+	defer commandRunner.Verify()
+
+	ready := filepath.Join(t.TempDir(), "ready")
+	withAICommand(t, writeHelper(t, "touch "+ready+"\ncat >/dev/null\nsleep 30\n"))
+	model := editingModel(t, commandRunner, "trunk()")
+	originalRevset := model.context.CurrentRevset
+
+	cmd, _ := model.HandleIntent(intents.Generate{})
+	_ = cmd()
+	runCmd := model.Update(input.SelectedMsg{Value: "request"})
+	require.NotNil(t, runCmd)
+
+	done := make(chan tea.Msg, 1)
+	go func() {
+		done <- runCmd()
+	}()
+
+	require.Eventually(t, func() bool {
+		_, err := os.Stat(ready)
+		return err == nil
+	}, 2*time.Second, 10*time.Millisecond)
+
+	applyCmd, handled := model.HandleIntent(intents.Apply{})
+	assert.True(t, handled)
+	assert.Nil(t, applyCmd)
+	assert.True(t, model.editing)
+	assert.Equal(t, "trunk()", model.GetValue())
+	assert.Equal(t, originalRevset, model.context.CurrentRevset)
+
+	select {
+	case result := <-done:
+		follow := model.Update(result)
+		assert.Nil(t, follow)
+	case <-time.After(5 * time.Second):
+		t.Fatal("generation command did not return after apply-cancel")
+	}
+
+	assert.True(t, model.editing)
+	assert.Equal(t, "trunk()", model.GetValue())
+	assert.Equal(t, originalRevset, model.context.CurrentRevset)
+}

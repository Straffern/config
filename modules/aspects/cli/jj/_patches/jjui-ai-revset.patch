+
+func withValidate(t *testing.T, fn func(context.Context, string, string) error) {
+	t.Helper()
+	original := validateGeneratedRevset
+	validateGeneratedRevset = fn
+	t.Cleanup(func() { validateGeneratedRevset = original })
+}
+
+func writeHelper(t *testing.T, body string) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "jj-revset-ai")
+	require.NoError(t, os.WriteFile(path, []byte("#!/bin/sh\n"+body+"\n"), 0o755))
+	return path
+}
+
+func withAICommand(t *testing.T, command string) {
+	t.Helper()
+	original := config.Current.Revset.AICommand
+	config.Current.Revset.AICommand = command
+	t.Cleanup(func() {
+		config.Current.Revset.AICommand = original
+	})
+}
+
+func editingModel(t *testing.T, runner *test.CommandRunner, buffer string) *Model {
+	t.Helper()
+	ctx := test.NewTestContext(runner)
+	ctx.CurrentRevset = "trunk()"
+	model := New(ctx)
+	model.editing = true
+	model.autoComplete.SetValue(buffer)
+	model.userInput = buffer
+	return model
+}
+
+func TestParseGeneratedRevset_RejectsBlankLineContamination(t *testing.T) {
+	_, err := parseGeneratedRevset("\nall()\n\n")
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "single line")
+	value, err := parseGeneratedRevset("all()\n")
+	require.NoError(t, err)
+	assert.Equal(t, "all()", value)
+}
+
+func TestGenerate_SuccessReplacesEditorBufferOnly(t *testing.T) {
+	commandRunner := test.NewTestCommandRunner(t)
+	defer commandRunner.Verify()
+
+	withValidate(t, func(context.Context, string, string) error { return nil })
+
+	withAICommand(t, writeHelper(t, `cat >/dev/null
+printf '%s\n' "$1"
+`))
+	model := editingModel(t, commandRunner, "trunk()")
+	originalRevset := model.context.CurrentRevset
+
+	cmd, handled := model.HandleIntent(intents.Generate{})
+	require.True(t, handled)
+	require.NotNil(t, cmd)
+	show := cmd()
+	_, ok := show.(common.ShowInputMsg)
+	require.True(t, ok)
+
+	runCmd := model.Update(input.SelectedMsg{Value: "all()"})
+	require.NotNil(t, runCmd)
+	result := runCmd()
+	follow := model.Update(result)
+	assert.Nil(t, follow)
+
+	assert.True(t, model.editing)
+	assert.Equal(t, "all()", model.GetValue())
+	assert.Equal(t, originalRevset, model.context.CurrentRevset)
+}
+
+func TestGenerate_InvalidOutputPreservesBuffer(t *testing.T) {
+	commandRunner := test.NewTestCommandRunner(t)
+	defer commandRunner.Verify()
+
+	withAICommand(t, writeHelper(t, `cat >/dev/null
+printf 'one()\ntwo()\n'
+`))
+	model := editingModel(t, commandRunner, "trunk()")
+	originalRevset := model.context.CurrentRevset
+
+	model.Update(input.SelectedMsg{}) // not awaiting
+	cmd, _ := model.HandleIntent(intents.Generate{})
+	_ = cmd()
+	runCmd := model.Update(input.SelectedMsg{Value: "anything"})
+	result := runCmd()
+	follow := model.Update(result)
+	require.NotNil(t, follow)
+	msg := follow()
+	add, ok := msg.(intents.AddMessage)
+	require.True(t, ok)
+	assert.Contains(t, add.Text, "single line")
+	assert.True(t, model.editing)
+	assert.Equal(t, "trunk()", model.GetValue())
+	assert.Equal(t, originalRevset, model.context.CurrentRevset)
+}
+

 /// `parent_of` over the live process tree. `ppid <= 1` (launchd / reparented)
 /// stops the walk.
 fn live_parent(pid: i32) -> Option<i32> {
-    pidinfo::<BSDInfo>(pid, 0)
-        .ok()
-        .map(|info| info.pbi_ppid as i32)
-        .filter(|&ppid| ppid > 1)
+    #[cfg(target_os = "macos")]
+    {
+        pidinfo::<BSDInfo>(pid, 0)
+            .ok()
+            .map(|info| info.pbi_ppid as i32)
+            .filter(|&ppid| ppid > 1)
+    }
+    #[cfg(target_os = "linux")]
+    {
+        let stat = std::fs::read_to_string(format!("/proc/{pid}/stat")).ok()?;
+        let (_, stat) = stat.rsplit_once(") ")?;
+        stat.split_whitespace()
+            .nth(1)
+            .and_then(|ppid| ppid.parse::<i32>().ok())
+            .filter(|&ppid| ppid > 1)
+    }
 }
 

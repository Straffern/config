{
  inputs,
  lib,
  ...
}: {
  imports = [
    (inputs.flake-file + "/modules/options")
    (inputs.flake-file + "/modules/write-flake.nix")
    (inputs.den.flakeModules.dendritic or {})
  ];

  options.flake-file = {
    apps = lib.mkOption {
      type = lib.types.lazyAttrsOf (lib.types.functionTo lib.types.package);
      default = {};
    };
    intoPath = lib.mkOption {
      type = lib.types.str;
      default = ".";
    };
    preProcess = lib.mkOption {
      type = lib.types.functionTo lib.types.raw;
      default = lib.id;
    };
  };
  config.flake-file.outputs = ''inputs: builtins.removeAttrs (inputs.flake-parts.lib.mkFlake { inherit inputs; } (inputs.import-tree ./modules)) [ "overlays" ]'';
  config.flake-file.formatter = pkgs: pkgs.alejandra;
  config.flake-file.do-not-edit = ''
    # DO-NOT-EDIT. Generated by github:denful/flake-file.
    # Use `nix run .#write-flake` to regenerate it.
  '';

  config.flake-file.inputs = {
    den.url = "github:denful/den";
    flake-file.url = "github:denful/flake-file/v0.6.0";
    flake-parts.url = "github:hercules-ci/flake-parts";
    import-tree.url = "github:denful/import-tree";
    nixpkgs.url = "github:nixos/nixpkgs/nixos-26.05";
    nixpkgs-lib.url = "github:nix-community/nixpkgs.lib";
    home-manager = {
      url = "github:nix-community/home-manager/release-26.05";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };
}
